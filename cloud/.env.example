# Copy to cloud/.env (gitignored) and fill in. Used by the simulator and seed scripts.
AWS_REGION=ap-southeast-2
AWS_DEFAULT_REGION=ap-southeast-2
# IoT Core -> Settings -> Device data endpoint
IOT_ENDPOINT=xxxxxxxxxxxxxx-ats.iot.ap-southeast-2.amazonaws.com
# SNS -> Topics -> heattrace_site_alerts
SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-2:ACCOUNT_ID:heattrace_site_alerts
# Only if you renamed tables
TABLE_READINGS=ht_readings
TABLE_WORKERS=ht_workers
TABLE_ZONES=ht_zones
TABLE_ALERTS=ht_alerts
TABLE_CONFIG=ht_config
